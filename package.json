{
  "name": "arena-duel",
  "productName": "Arena Duel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "check:bundle": "node scripts/check-bundle.mjs",
    "sim": "vitest run --config vitest.sim.config.ts progression --silent=false --reporter=default",
    "sim:cp": "vitest run --config vitest.sim.config.ts cpTable --silent=false --reporter=default",
    "smoke:ui": "node scripts/smoke/ui.mjs",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:build": "node scripts/desktop-build.mjs",
    "desktop:start": "electron .",
    "sim:orders": "vitest run --config vitest.sim.config.ts orderScale --silent=false --reporter=default",
    "sim:depths": "vitest run --config vitest.sim.config.ts depthReach --silent=false --reporter=default",
    "sim:items": "vitest run --config vitest.sim.config.ts itemAudit --silent=false --reporter=default",
    "sim:flow": "vitest run --config vitest.sim.config.ts materialFlow --silent=false --reporter=default",
    "sim:recipes": "vitest run --config vitest.sim.config.ts recipeTune --silent=false --reporter=default",
    "sim:skills": "vitest run --config vitest.sim.config.ts skillAudit --silent=false --reporter=default",
    "sim:long": "node scripts/sim/long.mjs",
    "sim:cost": "vitest run --config vitest.sim.config.ts lateCost --silent=false --reporter=default",
    "sim:wholesale": "vitest run --config vitest.sim.config.ts wholesale --silent=false --reporter=default"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@supabase/supabase-js": "^2.117.1",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^15.15.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.3"
  }
}
