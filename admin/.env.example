# Only these two, and only their NAMES live in the repository. The anon key is public by design (it is also in the game);
# the data is protected by the admin check inside the database functions (supabase/migrations/0020_admin.sql), not by hiding this key.
# NEVER put the service role key here: anything named VITE_* is shipped to every browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
